# =============================================================================
# IDP Project — Environment Variables
# =============================================================================

# Database
DATABASE_URL=postgresql+asyncpg://idp:idp_secret@localhost:5432/idp_db

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Provider: "claude" or "ollama"
LLM_PROVIDER=claude

# Anthropic (required if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Ollama (required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
MAX_BATCH_SIZE=20
ALLOWED_EXTENSIONS=pdf,docx,png,jpg,jpeg,tiff

# Webhook
WEBHOOK_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=INFO

# Sentry (optional)
SENTRY_DSN=

# App
APP_VERSION=0.1.0
