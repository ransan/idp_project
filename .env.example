# =============================================================================
# IDP Project — Environment Variables
# =============================================================================

# Database
DATABASE_URL=postgresql+asyncpg://idp:idp_secret@localhost:5432/idp_db

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Provider: "claude", "ollama", or "groq"
LLM_PROVIDER=claude

# Anthropic (required if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Groq (required if LLM_PROVIDER=groq)
GROQ_API_KEY=gsk_xxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
MAX_BATCH_SIZE=20
ALLOWED_EXTENSIONS=pdf,docx,png,jpg,jpeg,tiff

# Storage Backend: "local" or "minio"
STORAGE_BACKEND=local

# MinIO (required if STORAGE_BACKEND=minio)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=idp-documents
MINIO_SECURE=false

# Backblaze B2 (required if STORAGE_BACKEND=b2)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=IDP-B01
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_SECURE=true

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Webhook
WEBHOOK_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=INFO

# Sentry (optional)
SENTRY_DSN=

# App
APP_VERSION=0.1.0
